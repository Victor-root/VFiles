<resources>

    <attr name="colorAppBarSurface" format="color" />
    <attr name="colorOnAppBarSurface" format="color" />

    <declare-styleable name="AspectRatioFrameLayout">
        <attr name="aspectRatio" format="float" />
    </declare-styleable>

    <declare-styleable name="CoordinatorAppBarLayout">
        <!-- Keeps the app bar in place in edge-to-edge instead of scrolling it away with the
             content, for screens with actions pinned below the content that would otherwise end up
             off screen while the app bar is shown. -->
        <attr name="pinnedInEdgeToEdge" format="boolean" />
    </declare-styleable>

    <declare-styleable name="NavigationViewExtra">
        <attr name="itemSubtitleTextAppearance" format="reference" />
        <attr name="itemSubtitleTextColor" format="color" />
        <attr name="itemSubtitleTextSize" format="dimension" />
        <attr name="dividerVerticalPadding" format="dimension" />
    </declare-styleable>
</resources>
