<merge
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <me.zhanghai.android.files.ui.PersistentBarLayout
        android:id="@+id/persistentBarLayout"
        android:layout_height="match_parent"
        android:layout_width="match_parent"
        android:fitsSystemWindows="true">

        <!--
          ~ The app bar spans the full width above the persistent drawer and the file list, and
          ~ both of them scroll together below it, so the app bar can move away with the content
          ~ in edge-to-edge like on every other screen.
          -->
        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fitsSystemWindows="true">

            <include layout="@layout/file_list_fragment_app_bar_include" />

            <me.zhanghai.android.files.ui.PersistentDrawerLayout
                android:id="@+id/persistentDrawerLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fitsSystemWindows="true"
                app:layout_behavior="me.zhanghai.android.files.ui.FitsSystemWindowsScrollingViewBehavior">

                <me.zhanghai.android.files.ui.NavigationFrameLayout
                    android:id="@+id/navigationFragment"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="start"
                    android:background="?colorSurface" />

                <include layout="@layout/file_list_fragment_content_include" />
            </me.zhanghai.android.files.ui.PersistentDrawerLayout>
        </androidx.coordinatorlayout.widget.CoordinatorLayout>

        <include layout="@layout/file_list_fragment_bottom_bar_include" />

        <include layout="@layout/file_list_fragment_progress_include" />

        <include layout="@layout/file_list_fragment_speed_dial_include" />
    </me.zhanghai.android.files.ui.PersistentBarLayout>
</merge>
