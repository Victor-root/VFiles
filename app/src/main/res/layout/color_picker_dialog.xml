<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="@dimen/abc_dialog_title_divider_material">

    <!-- The wallpaper/dynamic color is shown apart from the fixed colors, with its own label, so it
         is clear that it follows the system colors rather than being just another preset. Only shown
         on Android 12+ where dynamic colors exist. -->
    <LinearLayout
        android:id="@+id/dynamicColorSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="?dialogPreferredPadding"
        android:paddingEnd="?dialogPreferredPadding"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/dynamicColorLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/color_picker_dynamic_color_label"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <me.zhanghai.android.files.colorpicker.ColorSwatchView
            android:id="@+id/dynamicColorSwatch"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <View
        android:id="@+id/dynamicColorDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="?dialogPreferredPadding"
        android:layout_marginEnd="?dialogPreferredPadding"
        android:background="?android:attr/listDivider"
        android:visibility="gone" />

    <TextView
        android:id="@+id/presetColorsLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="?dialogPreferredPadding"
        android:paddingEnd="?dialogPreferredPadding"
        android:paddingTop="12dp"
        android:text="@string/color_picker_preset_colors_label"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <GridView
        android:id="@+id/palette"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="?dialogPreferredPadding"
        android:paddingEnd="?dialogPreferredPadding"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:choiceMode="singleChoice"
        android:clipToPadding="false"
        android:columnWidth="48dp"
        android:drawSelectorOnTop="true"
        android:horizontalSpacing="16dp"
        android:listSelector="@drawable/color_picker_focus_ring"
        android:numColumns="auto_fit"
        android:scrollIndicators="top|bottom"
        android:scrollbarStyle="outsideOverlay"
        android:stretchMode="spacingWidth"
        android:verticalSpacing="16dp" />
</LinearLayout>
